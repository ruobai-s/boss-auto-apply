{
  "manifest_version": 3,
  "name": "BOSS 本地投递助手",
  "version": "0.1.0",
  "description": "连接本机管理端，检查 BOSS 页面、登录和安全状态。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:18080/*",
    "https://www.zhipin.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "BOSS 本地投递助手",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["content/boss-status.js"],
      "run_at": "document_idle"
    }
  ]
}
